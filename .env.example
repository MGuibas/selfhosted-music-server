# Normalmente lo genera `python setup.py`. Si prefieres hacerlo a mano, copia este archivo a .env.
# NO subas .env a git.

# Contraseña del panel web (obligatoria, elige una larga)
APP_PASSWORD=cambia-esto

# Carpeta donde se guardará la música (usa / también en Windows: D:/Musica)
MUSIC_PATH=./music

# Puerto del panel web
WEB_PORT=8501

# --- Navidrome (opcional) ---
# Para activarlo descomenta estas dos líneas:
# COMPOSE_PROFILES=navidrome
# NAVIDROME_ENABLED=1
# NAVIDROME_PORT=4533
# Usuario/contraseña de Navidrome (los creas al abrir http://localhost:4533 por primera vez).
# Opcional: permite que tras cada descarga se reescanee la biblioteca al instante.
# NAVIDROME_USER=
# NAVIDROME_PASSWORD=

# Descargas simultáneas por defecto (también editable desde el panel)
# BATCH_SIZE=3

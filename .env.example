# Copia este archivo a .env y rellénalo. NO subas .env a git.

# Contraseña del panel web (obligatoria, elige una larga)
APP_PASSWORD=cambia-esto

# Usuario/contraseña de Navidrome (los creas la primera vez que abres http://localhost:4533).
# Opcionales: sirven para que tras cada sincronización se fuerce un reescaneo al instante.
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Descargas simultáneas (por defecto 3)
# BATCH_SIZE=3
